{
  "manifest_version": 2,
  "id": "WMX20081122.maibot-picstatus",
  "version": "2.3.3",
  "name": "PicStatus-Re",
  "description": "以图片形式显示当前设备的运行状态（CPU、内存、磁盘、网络、进程等）。MaiBot 移植版，迁移来源：nonebot-plugin-picstatus（作者 yuexps）。",
  "author": {
    "name": "WMX20081122",
    "url": "https://github.com/WMX20081122"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/WMX20081122/maibot-picstatus",
    "homepage": "https://github.com/WMX20081122/maibot-picstatus",
    "documentation": "https://github.com/WMX20081122/maibot-picstatus/blob/main/README.md",
    "issues": "https://github.com/WMX20081122/maibot-picstatus/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "maibot-team.snowluma-adapter",
      "version_spec": ">=0.1.0"
    },
    {
      "type": "python_package",
      "name": "psutil",
      "version_spec": ">=5.9.0"
    },
    {
      "type": "python_package",
      "name": "py-cpuinfo",
      "version_spec": ">=9.0.0"
    },
    {
      "type": "python_package",
      "name": "jinja2",
      "version_spec": ">=3.0.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    },
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.40.0"
    }
  ],
  "capabilities": [
    "api.call",
    "send.image",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "📊",
      "background": "#2f5fff"
    }
  }
}
